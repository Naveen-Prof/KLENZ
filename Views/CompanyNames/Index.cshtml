@model IEnumerable<KLENZ.Models.CompanyName>

@{
    ViewData["Title"] = "Company Names";
}

<script src="~/js/custom_datatables.js"></script>

<div class="card rounded-card shadow-lg mt-3">
    <div class="card-header d-flex justify-content-between align-items-center bg-primary bg-opacity-75 text-white rounded-top">
        <div class="d-flex align-items-center">
            <i class="bi bi-building me-2 fs-4"></i>
            <h4 class="mb-0">Company Names</h4>
        </div>
        <div class="text-white-50 small">
            <i class="bi bi-info-circle me-1"></i> Companies are managed via database query
        </div>
    </div>

    <div class="card-body">
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>@TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table datatable rounded-table align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width: 130px;">Sequence No</th>
                        <th>Full Name</th>
                        <th>Short Name</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Created User</th>
                        <th class="action-column text-center" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-1.5 fs-6 rounded-pill fw-bold">
                                    #@item.SequenceNo
                                </span>
                            </td>
                            <td>@item.FullName</td>
                            <td><strong class="text-dark">@item.ShortName</strong></td>
                            <td>
                                @if (item.IsActive == 1)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1 fs-7 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1 text-success"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2.5 py-1 fs-7 rounded-pill">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td>@item.CreatedDateTime?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(item.CreatedUserName) ? "System" : item.CreatedUserName)</td>
                            <td class="action-column text-center">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" title="Edit" class="text-decoration-none">
                                        <i class="bi bi-pencil-square text-success fs-5"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" title="Details" class="text-decoration-none">
                                        <i class="bi bi-info-circle text-primary fs-5"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" title="Delete" class="text-decoration-none">
                                        <i class="bi bi-trash text-danger fs-5"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
