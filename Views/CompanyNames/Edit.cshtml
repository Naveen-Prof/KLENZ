@model KLENZ.Models.CompanyName

@{
    ViewData["Title"] = "Edit Company Name";
}

<div class="card shadow-lg rounded-card border-0">
    <div class="card-header bg-warning text-white text-center py-2">
        <h5 class="mb-0">Edit Company Name</h5>
    </div>

    <div class="card-body p-3">
        <form asp-action="Edit" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDateTime" />
            <input type="hidden" asp-for="CreatedUserId" />

            <div class="row align-items-center mb-3">
                <label asp-for="FullName" class="col-md-4 col-form-label fw-bold text-md-end"></label>
                <div class="col-md-5">
                    <input asp-for="FullName" class="form-control border-warning shadow-sm" placeholder="Enter Full Company Name" required />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div>

            <div class="row align-items-center mb-3">
                <label asp-for="ShortName" class="col-md-4 col-form-label fw-bold text-md-end"></label>
                <div class="col-md-5">
                    <input asp-for="ShortName" class="form-control border-warning shadow-sm" placeholder="Enter Short Name / Initials" required />
                    <span asp-validation-for="ShortName" class="text-danger"></span>
                </div>
            </div>

            <div class="row align-items-center mb-3">
                <div class="col-md-5 offset-md-4">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="1"
                               @(Model?.IsActive == 1 ? "checked" : "") />
                        <label class="form-check-label fw-bold ms-2" for="IsActive">Active</label>
                    </div>
                    <span asp-validation-for="IsActive" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-warning px-4">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
