@model KLENZ.Models.CompanyName

@{
    ViewData["Title"] = "Create Company Name";
}

<div class="card shadow-lg rounded-card border-0 mt-4">
    <div class="card-header bg-primary bg-opacity-75 text-white text-center py-2">
        <h5 class="mb-0">Create Company</h5>
    </div>

    <div class="card-body p-4 text-center">
        <div class="alert alert-info d-inline-block text-start p-3 shadow-sm" style="max-width: 650px;">
            <h6 class="fw-bold mb-2"><i class="bi bi-info-circle-fill me-2"></i>Company Creation via UI is Disabled</h6>
            <p class="mb-2">As per system design, companies are inserted directly using SQL queries:</p>
            <pre class="bg-dark text-light p-3 rounded mb-0"><code>INSERT INTO Services.Companies (SequenceNo, FullName, ShortName, IsActive, CreatedDateTime)
VALUES (1, 'KLENZ SOLUTIONS', 'KLENZ', 1, GETDATE());</code></pre>
        </div>

        <div class="mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to Companies List
            </a>
        </div>
    </div>
</div>
