@model KLENZ.Models.CompanyName

@{
    ViewData["Title"] = "Delete Company";
}

<div class="card shadow-lg rounded-card border-0 mt-3">
    <div class="card-header bg-secondary text-white py-2.5 px-3 rounded-top d-flex align-items-center">
        <i class="bi bi-shield-lock me-2 fs-4"></i>
        <h5 class="mb-0 fw-semibold">Company Deletion Disabled</h5>
    </div>
    <div class="card-body p-4 text-center">
        <div class="alert alert-warning d-inline-block text-start p-3 shadow-sm" style="max-width: 600px;">
            <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Company Deletion is Disabled</h6>
            <p class="mb-0">Companies cannot be deleted through the user interface. Companies are persistent across multi-company workspace modules.</p>
        </div>

        <div class="mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to Companies List
            </a>
        </div>
    </div>
</div>
