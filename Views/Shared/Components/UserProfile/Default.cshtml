@model string

<a class="nav-link dropdown-toggle text-dark d-flex align-items-center" href="#" role="button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
    <img src="@Model" alt="Profile" class="rounded-circle border" width="32" height="32">
    <i class="bi bi-chevron-up dropdown-icon ms-1"></i>
</a>
<ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" aria-labelledby="profileDropdown">
    <li>
        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/MyProfile">
            <i class="bi bi-person-circle me-2 text-primary"></i>My Profile
        </a>
    </li>
    <li><hr class="dropdown-divider"></li>
    <li>
        <form method="post" asp-area="Identity" asp-page="/Account/Logout">
            <button type="submit" class="dropdown-item text-danger">
                <i class="bi bi-box-arrow-right me-2 text-danger"></i>Logout
            </button>
        </form>
    </li>
</ul>
