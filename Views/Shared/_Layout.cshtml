@inject KLENZ.Services.ICompanyContext CompanyContext
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KLENZ</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" /> *@
    <link rel="stylesheet" href="~/KLENZ.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="@Url.Content("~/favicon.ico")" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css">
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="content">
        <!-- Conditionally hide navbar for Login & Register auth pages -->
        @{
            var pageName = ViewContext.RouteData.Values["Page"]?.ToString() ?? "";
            var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
            var isAuthPage = pageName.Contains("/Account/Register") || pageName.Contains("/Account/Login");
            var isCompanySelectionPage = string.Equals(controllerName, "CompanySelection", StringComparison.OrdinalIgnoreCase);
        }
        @if (!isAuthPage)
        {
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3 rounded-navbar">
                <div class="container-fluid">
                    <!-- Left: Brand & Toggler -->
                    @if (!isCompanySelectionPage)
                    {
                        <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index" title="@CompanyContext.CurrentCompanyName">
                            @(CompanyContext.HasSelectedCompany ? (CompanyContext.CurrentCompanyShortName ?? CompanyContext.CurrentCompanyName) : "KLENZ")
                        </a>
                    }
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <!-- Center: Collapsible Menu -->
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav me-auto">
                            @* Dashboard commented out for now
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" id="nav-sales-dropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Sales <i class="bi bi-chevron-up dropdown-icon ms-1"></i>
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0" aria-labelledby="nav-sales-dropdown">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="SalesEnquiries" asp-action="Index"><i class="bi bi-chat-left-dots me-2 text-primary"></i>Sales Enquiry</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="QuotationReports" asp-action="Index"><i class="bi bi-file-earmark-ruled me-2 text-success"></i>Quotation Report</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="PositiveEnquiries" asp-action="Index"><i class="bi bi-check-circle me-2 text-info"></i>Positive Enquiry</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ProjectLists" asp-action="Index"><i class="bi bi-list-task me-2 text-warning"></i>Project List</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" id="nav-project-dropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Projects <i class="bi bi-chevron-up dropdown-icon ms-1"></i>
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0" aria-labelledby="nav-project-dropdown">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ProjectConsultancy" asp-action="Index"><i class="bi bi-briefcase me-2 text-secondary"></i>Consultancy</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ProjectTenderList" asp-action="Index"><i class="bi bi-file-text me-2 text-danger"></i>Tender List</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ProjectToBeTenderList" asp-action="Index"><i class="bi bi-hourglass-split me-2 text-warning"></i>To Be Tender List</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ProjectKlenzChemicals" asp-action="Index"><i class="bi bi-flask me-2 text-success"></i>Klenz Chemicals</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" id="nav-services-dropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Services <i class="bi bi-chevron-up dropdown-icon ms-1"></i>
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0" aria-labelledby="nav-services-dropdown">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="FinancialYears" asp-action="Index"><i class="bi bi-calendar2-check me-2 text-primary"></i>Financial Years</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="GSTTypes" asp-action="Index"><i class="bi bi-percent me-2 text-success"></i>GST Types</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="CompanyNames" asp-action="Index"><i class="bi bi-building me-2 text-warning"></i>Company Names</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>

                    <!-- Right: Company Workspace & Profile Dropdown -->
                    <div class="d-flex align-items-center ms-auto gap-2">
                        @if ((User.Identity?.IsAuthenticated ?? false) && !isCompanySelectionPage)
                        {
                            @if (CompanyContext.HasSelectedCompany)
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 d-flex align-items-center gap-2 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Active Company Workspace">
                                        <i class="bi bi-building"></i>
                                        <span class="fw-semibold">@CompanyContext.CurrentCompanyShortName</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2">
                                        <li class="dropdown-header text-uppercase small text-muted">Active Workspace</li>
                                        <li><span class="dropdown-item-text fw-bold text-dark">@CompanyContext.CurrentCompanyName</span></li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item text-primary" asp-area="" asp-controller="CompanySelection" asp-action="Index">
                                                <i class="bi bi-arrow-repeat me-2"></i> Switch Company
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a asp-area="" asp-controller="CompanySelection" asp-action="Index" class="btn btn-sm btn-warning rounded-pill px-3 py-1 fw-semibold text-dark">
                                    <i class="bi bi-building-add me-1"></i> Select Company
                                </a>
                            }
                        }

                        <div class="dropdown">
                            @await Component.InvokeAsync("UserProfile")
                        </div>
                    </div>
                </div>
            </nav>

        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- 🔹 jQuery (Ensure only ONE instance is loaded) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- 🔹 Bootstrap & Site Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- 🔹 DataTables -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

    <!-- 🔹 Custom Scripts (Moved to Bottom) -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="~/js/custom_layout.js"></script>
    <script src="~/js/custom_datatables.js"></script>
    <script src="~/js/site.js"></script>

    <!-- 🔹 Toastr Notifications -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "4000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };

            @if (TempData["SuccessMessage"] != null)
            {
                <text>toastr.success(@Json.Serialize(TempData["SuccessMessage"]));</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>toastr.error(@Json.Serialize(TempData["ErrorMessage"]));</text>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <text>toastr.warning(@Json.Serialize(TempData["WarningMessage"]));</text>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <text>toastr.info(@Json.Serialize(TempData["InfoMessage"]));</text>
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
