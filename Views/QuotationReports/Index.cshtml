@model IEnumerable<KLENZ.Models.QuotationReport>

@{
    ViewData["Title"] = "Quotation Reports";
}

<script src="~/js/custom_datatables.js"></script>


<div class="card rounded-card shadow-lg mt-3">
    <div class="card-header d-flex justify-content-between align-items-center bg-primary bg-opacity-75 text-white rounded-top">
        <div class="d-flex align-items-center">
            <i class="bi bi-clipboard-data me-2 fs-4"></i>
            <h4 class="mb-0">Quotation Reports</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-light text-primary shadow-sm custom-btn">
                <i class="bi bi-plus-circle me-1"></i> Create New
            </a>
            <i id="exportExcel" class="mt-1 bi bi-file-earmark-excel-fill text-success fs-4 export-icon"></i>
            <i id="exportPdf" class="mt-1 bi bi-file-earmark-pdf-fill text-danger fs-4 export-icon"></i>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table datatable rounded-table align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="action-column">Actions</th>
                        <th>Quotation Date</th>
                        <th>Company Name</th>
                        <th>Product Details</th>
                        <th>Customer Details</th>
                        <th>Quotation Value</th>
                        <th>Remarks</th>
                        <th class="text-center">Is Positive?</th>
                        <th>Created Date</th>
                        <th>Created User</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="action-column">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" title="Edit" class="text-decoration-none">
                                        <i class="bi bi-pencil-square text-success fs-5"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" title="Details" class="text-decoration-none">
                                        <i class="bi bi-info-circle text-primary fs-5"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" title="Delete" class="text-decoration-none">
                                        <i class="bi bi-trash text-danger fs-5"></i>
                                    </a>
                                </div>
                            </td>
                            <td>@item.QuotationDate?.ToString("dd/MM/yyyy")</td>
                            <td><strong class="text-dark">@(item.Company?.ShortName ?? "N/A")</strong></td>
                            <td>@item.ProductDetails</td>
                            <td>@item.CustomerDetails</td>
                            <td>@(item.QuotationValue.HasValue ? item.QuotationValue.Value.ToString("C") : "N/A")</td>
                            <td>@item.Remarks</td>
                            <td class="text-center">
                                @if (item.IsPositive == 1)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1 fs-7 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1 text-success"></i> Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2.5 py-1 fs-7 rounded-pill">
                                        No
                                    </span>
                                }
                            </td>
                            <td>@item.CreatedDateTime?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(item.CreatedUserName) ? "System" : item.CreatedUserName)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/js/pdf_excel_export.js"></script>
