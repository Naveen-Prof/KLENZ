@model IEnumerable<KLENZ.Models.Project_ToBeTenderList>

@{
    ViewData["Title"] = "Projects To Be Tendered";
}

<script src="~/js/custom_datatables.js"></script>
<style>
    .table {
        table-layout: fixed;
        width: 99%;
    }

        .table th, .table td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
</style>

<div class="card rounded-card shadow-lg">
    <div class="card-header d-flex justify-content-between align-items-center bg-primary bg-opacity-75 text-white rounded-top">
        <div class="d-flex align-items-center">
            <i class="bi bi-briefcase-fill me-2 fs-4"></i>
            <h4 class="mb-0">Projects To Be Tendered</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-light text-primary shadow-sm custom-btn">
                <i class="bi bi-plus-circle me-1"></i> Create New
            </a>
            <i id="exportExcel" class="mt-1 bi bi-file-earmark-excel-fill text-success fs-4 export-icon" title="Export to Excel"></i>
            <i id="exportPdf" class="mt-1 bi bi-file-earmark-pdf-fill text-danger fs-4 export-icon" title="Export to PDF"></i>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive table table-striped">
            <table class="table datatable rounded-table">
                <thead class="table-primary">
                    <tr>
                        <th>Actions</th>
                        <th>@Html.DisplayNameFor(model => model.WorkOrderDate)</th>
                        <th>@Html.DisplayNameFor(model => model.CustomerDetails)</th>
                        <th>@Html.DisplayNameFor(model => model.WorkDetails)</th>
                        <th>@Html.DisplayNameFor(model => model.ProjectCost)</th>
                        <th>@Html.DisplayNameFor(model => model.Total)</th>
                        <th>@Html.DisplayNameFor(model => model.WorkDuration)</th>
                        <th>@Html.DisplayNameFor(model => model.Remarks)</th>
                        <th>@Html.DisplayNameFor(model => model.CreatedDateTime)</th>
                        <th>@Html.DisplayNameFor(model => model.CreatedUserId)</th>
                        <th>@Html.DisplayNameFor(model => model.FinancialYear.FyYear)</th>
                        <th>@Html.DisplayNameFor(model => model.Company.FullName)</th>
                        <th>@Html.DisplayNameFor(model => model.GSTType.Id)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" title="Edit" class="text-decoration-none">
                                    <i class="bi bi-pencil-square text-success"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" title="Details" class="text-decoration-none">
                                    <i class="bi bi-eye ms-1" style="color:blue"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" title="Delete" class="text-decoration-none">
                                    <i class="bi bi-trash-fill ms-1" style="color:red"></i>
                                </a>
                            </td>
                            <td>@item.WorkOrderDate?.ToShortDateString()</td>
                            <td>@Html.DisplayFor(modelItem => item.CustomerDetails)</td>
                            <td>@Html.DisplayFor(modelItem => item.WorkDetails)</td>
                            <td>@Html.DisplayFor(modelItem => item.ProjectCost)</td>
                            <td>@Html.DisplayFor(modelItem => item.Total)</td>
                            <td>@Html.DisplayFor(modelItem => item.WorkDuration)</td>
                            <td>@Html.DisplayFor(modelItem => item.Remarks)</td>
                            <td>@item.CreatedDateTime?.ToShortDateString()</td>
                            <td>@Html.DisplayFor(modelItem => item.CreatedUserId)</td>
                            <td>@Html.DisplayFor(modelItem => item.FinancialYear.FyYear)</td>
                            <td>@Html.DisplayFor(modelItem => item.Company.FullName)</td>
                            <td>@Html.DisplayFor(modelItem => item.GSTType.Id)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/js/pdf_excel_export.js"></script>
