@model KLENZ.Models.CompanySelectionViewModel
@{
    ViewData["Title"] = "Select Company Workspace";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-4 pb-2 border-bottom">
        <div class="col-md-7">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-primary bg-gradient rounded-4 text-white shadow-sm d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-building fs-3"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-1 text-dark">Company Workspaces</h2>
                    <p class="text-muted mb-0">Select a company below to explore its sales, projects, and services records</p>
                </div>
            </div>
        </div>
        <div class="col-md-5 mt-3 mt-md-0">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="companySearchInput" class="form-control border-start-0 ps-0" placeholder="Search by name or code..." aria-label="Search companies" />
            </div>
        </div>
    </div>

    <!-- Active Company Banner if one is currently selected -->
    @if (Model.CurrentCompanyId.HasValue && !string.IsNullOrEmpty(Model.CurrentCompanyName))
    {
        <div class="card border-0 bg-primary bg-opacity-10 rounded-4 p-3 mb-4 d-flex flex-row align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success px-2 py-1"><i class="bi bi-check-circle me-1"></i>Active</span>
                <span class="text-muted">You are currently working in:</span>
                <strong class="text-primary fs-6">@Model.CurrentCompanyName</strong>
            </div>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-primary">
                    <i class="bi bi-briefcase me-1"></i> Go to Workspace
                </a>
            </div>
        </div>
    }

    <!-- Company Cards Grid -->
    @if (Model.Companies == null || !Model.Companies.Any())
    {
        <div class="card border-dashed p-5 text-center my-4 bg-light rounded-4">
            <div class="mb-3">
                <i class="bi bi-building-slash text-muted" style="font-size: 3rem;"></i>
            </div>
            <h4 class="fw-bold text-dark">No Active Companies Found</h4>
            <p class="text-muted">There are no active companies configured in the system yet.</p>
            <div class="mt-2">
                <span class="badge bg-secondary-subtle text-secondary px-3 py-2">
                    <i class="bi bi-database me-1"></i> Companies configured via database query
                </span>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="companyCardsGrid">
            @foreach (var company in Model.Companies)
            {
                <div class="col company-card-item" data-search="@(company.FullName.ToLower()) @(company.ShortName.ToLower())">
                    <div class="card h-100 border-0 shadow-sm rounded-4 transition-hover @(company.IsCurrent ? "border-primary border-2 shadow" : "")" style="transition: all 0.25s ease;">
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- Top row: Avatar & Badges -->
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                                     style="width: 52px; height: 52px; background: linear-gradient(135deg, #1e3a8a, #3b82f6); font-size: 1.15rem;">
                                    @(company.ShortName.Length > 2 ? company.ShortName.Substring(0, 2).ToUpper() : company.ShortName.ToUpper())
                                </div>
                                <div class="d-flex gap-1 align-items-center">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-2 py-1 fw-bold">
                                        Seq #@company.SequenceNo
                                    </span>
                                    <span class="badge bg-light text-primary border border-primary-subtle px-2 py-1 fw-semibold">
                                        @company.ShortName
                                    </span>
                                    @if (company.IsCurrent)
                                    {
                                        <span class="badge bg-success px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Current
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Company Name -->
                            <h5 class="fw-bold text-dark mb-1 text-truncate" title="@company.FullName">@company.FullName</h5>
                            <small class="text-muted mb-3 d-block">Sequence: <strong>#@company.SequenceNo</strong> &bull; Workspace ID: @company.Id</small>

                            <!-- Metric counters -->
                            <div class="bg-light rounded-3 p-2 mb-4 mt-auto">
                                <div class="row text-center g-1">
                                    <div class="col-4 border-end">
                                        <div class="text-muted small" style="font-size: 0.72rem;">SALES</div>
                                        <div class="fw-bold text-dark">@company.SalesCount</div>
                                    </div>
                                    <div class="col-4 border-end">
                                        <div class="text-muted small" style="font-size: 0.72rem;">PROJECTS</div>
                                        <div class="fw-bold text-dark">@company.ProjectCount</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted small" style="font-size: 0.72rem;">QUOTES</div>
                                        <div class="fw-bold text-dark">@company.QuotationCount</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Action button -->
                            <a asp-action="Explore" asp-route-id="@company.Id"
                               class="btn @(company.IsCurrent ? "btn-outline-primary" : "btn-primary") w-100 py-2 d-flex align-items-center justify-content-center gap-2 fw-semibold rounded-3">
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>@(company.IsCurrent ? "Continue Exploring" : "Explore Company")</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("companySearchInput");
            const cards = document.querySelectorAll(".company-card-item");

            if (searchInput && cards.length > 0) {
                searchInput.addEventListener("input", function () {
                    const query = this.value.trim().toLowerCase();
                    cards.forEach(card => {
                        const searchTarget = card.getAttribute("data-search") || "";
                        if (searchTarget.includes(query)) {
                            card.style.display = "";
                        } else {
                            card.style.display = "none";
                        }
                    });
                });
            }
        });
    </script>
}
