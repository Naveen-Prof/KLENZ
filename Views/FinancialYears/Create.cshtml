@model KLENZ.Models.FinancialYear

@{
    ViewData["Title"] = "Create Financial Year";
}

<div class="card shadow-lg rounded-card border-0">
    <div class="card-header bg-primary text-white text-center py-2 d-flex justify-content-between align-items-center px-4">
        <h5 class="mb-0">Create Financial Year</h5>
        @if (ViewBag.CurrentCompanyName != null)
        {
            <span class="badge bg-light text-primary fs-6">Company: @ViewBag.CurrentCompanyName</span>
        }
    </div>

    <div class="card-body p-3">
        <form asp-action="Create" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>
            <input type="hidden" asp-for="CompanyNameId" />

            <div class="row align-items-center mb-3">
                <label asp-for="StartDate" class="col-md-4 col-form-label fw-bold text-md-end"></label>
                <div class="col-md-4">
                    <input asp-for="StartDate" type="date" class="form-control border-primary shadow-sm" required />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row align-items-center mb-3">
                <label asp-for="EndDate" class="col-md-4 col-form-label fw-bold text-md-end"></label>
                <div class="col-md-4">
                    <input asp-for="EndDate" type="date" class="form-control border-primary shadow-sm" required />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row align-items-center mb-3">
                <div class="col-md-6 offset-md-4">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="IsActiveBool" name="IsActiveBool"
                               value="true" @(Model?.IsActiveBool == true ? "checked" : "") />
                        <label class="form-check-label fw-bold ms-2" for="IsActiveBool">Active (Deactivates other financial years)</label>
                    </div>
                    <span asp-validation-for="IsActiveBool" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-primary px-4">Create</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
