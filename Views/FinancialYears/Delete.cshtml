@model KLENZ.Models.FinancialYear

@{
    ViewData["Title"] = "Delete Financial Year";
}

<div class="card shadow-lg rounded-card border-0">
    <div class="card-header bg-danger text-white py-2">
        <h5 class="mb-0">Delete Financial Year</h5>
    </div>
    <div class="card-body p-4">
        <h5 class="text-danger mb-3">Are you sure you want to delete this Financial Year?</h5>
        <dl class="row">
            <dt class="col-sm-3">Start Date</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@Model.EndDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Financial Year</dt>
            <dd class="col-sm-9"><strong>@Model.FyYear</strong></dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.IsActive == 1 ? "Active" : "Inactive")</dd>
        </dl>
        
        <form asp-action="Delete" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger px-4">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4 ms-2">Cancel</a>
        </form>
    </div>
</div>
