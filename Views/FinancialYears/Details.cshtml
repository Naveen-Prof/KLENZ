@model KLENZ.Models.FinancialYear

@{
    ViewData["Title"] = "Financial Year Details";
}

<div class="card shadow-lg rounded-card border-0">
    <div class="card-header bg-info text-white py-2">
        <h5 class="mb-0">Financial Year Details</h5>
    </div>
    <div class="card-body p-4">
        <dl class="row">
            <dt class="col-sm-3">Start Date</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@Model.EndDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Financial Year</dt>
            <dd class="col-sm-9"><strong>@Model.FyYear</strong></dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive == 1)
                {
                    <span class="badge bg-success px-3 py-2">Active financial year @Model.FyYear</span>
                }
                else
                {
                    <span class="badge bg-secondary px-3 py-2">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3">Created Date</dt>
            <dd class="col-sm-9">@Model.CreatedDateTime?.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning px-4">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
        </div>
    </div>
</div>
