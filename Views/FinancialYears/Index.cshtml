@model IEnumerable<KLENZ.Models.FinancialYear>

@{
    ViewData["Title"] = "Financial Years";
}

<script src="~/js/custom_datatables.js"></script>
<script src="~/js/pdf_excel_export.js"></script>

<div class="card rounded-card shadow-lg mt-3">
    <div class="card-header d-flex justify-content-between align-items-center bg-primary bg-opacity-75 text-white rounded-top">
        <div class="d-flex align-items-center">
            <i class="bi bi-calendar2-check me-2 fs-4"></i>
            <h4 class="mb-0">Financial Years</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-light text-primary shadow-sm custom-btn">
                <i class="bi bi-plus-circle me-1"></i> Create New
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table datatable rounded-table align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="action-column">Actions</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Financial Year</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Created User</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isCurrentActive = item.IsActive == 1;
                        <tr class="@(isCurrentActive ? "table-success bg-opacity-25" : "")">
                            <td class="action-column">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" title="Edit" class="text-decoration-none">
                                        <i class="bi bi-pencil-square text-success fs-5"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" title="Details" class="text-decoration-none">
                                        <i class="bi bi-info-circle text-primary fs-5"></i>
                                    </a>
                                </div>
                            </td>
                            <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <strong class="text-dark">@item.FyYear</strong>
                            </td>
                            <td>
                                @if (isCurrentActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 fs-6 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1 text-success"></i> @item.FyYear
                                    </span>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary px-2 py-1 shadow-sm">
                                            <i class="bi bi-power me-1"></i> Set Active
                                        </button>
                                    </form>
                                }
                            </td>
                            <td>@item.CreatedDateTime?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(item.CreatedUserName) ? "System" : item.CreatedUserName)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
