@model KLENZ.Models.GSTTypes

@{
    ViewData["Title"] = "Create GST Type";
}

<div class="card shadow-lg rounded-card border-0">
    <div class="card-header bg-primary text-white text-center py-2">
        <h5 class="mb-0">Create GST Type</h5>
    </div>

    <div class="card-body p-3">
        <form asp-action="Create" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

            <div class="row align-items-center mb-3">
                <label asp-for="GSTType" class="col-md-4 col-form-label fw-bold text-md-end"></label>
                <div class="col-md-4">
                    <div class="input-group">
                        <input asp-for="GSTType" class="form-control border-primary shadow-sm" placeholder="Enter GST Rate" required />
                        <span class="input-group-text bg-primary text-white">%</span>
                    </div>
                    <span asp-validation-for="GSTType" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-primary px-4">Create</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
